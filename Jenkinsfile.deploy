pipeline {
    agent { label 'mac-agent' }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Tag immagine Docker da deployare')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Helm Deploy') {
            steps {
                sh """
                    helm upgrade --install flask-app charts/flask-app \
                    --namespace formazione-sou \
                    --set image.tag=${params.IMAGE_TAG}
                """
            }
        }

        stage('Verifica Deploy') {
            steps {
                sh 'kubectl get pods -n formazione-sou'
            }
        }
    }
}